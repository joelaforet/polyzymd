    given-names: "Joseph R."
    name-suffix: "Jr."
    email: "jola3134@colorado.edu"
    affiliation: "Shirts group, Department of Chemical and Biological Engineering, University of Colorado Boulder"
keywords:
  - molecular dynamics
  - enzyme-polymer conjugates
  - trajectory analysis
  - uncertainty quantification
  - OpenMM
  - MDAnalysis
