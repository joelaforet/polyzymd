def test_compute_reports_one_value_per_selected_frame() -> None:
    """The observable covers the production window and states its unit."""
    universe = synthetic_universe()
    settings = {{ spec.class_name }}Settings()

    observables = {{ spec.class_name }}().compute(universe, all_frames(universe), settings)

    assert [observable.kind for observable in observables] == ["mean_of_timeseries"]
    assert len(observables[0].values) == 5
    assert observables[0].values[0] == pytest.approx(1.0)


def test_aggregates_over_three_replicates() -> None:
    """Three identical replicates give the known mean and a zero SEM."""
    settings = {{ spec.class_name }}Settings()

    aggregates = run_in_memory({{ spec.class_name }}, settings, synthetic_universe())

    assert aggregates[0].n_replicates == 3
    assert aggregates[0].replicate_values == pytest.approx([1.0, 1.0, 1.0])
    assert aggregates[0].mean == pytest.approx(1.0)
    assert aggregates[0].sem == pytest.approx(0.0)
