"""Tests for the {{ spec.name }} scalar measurement analysis plugin."""

from __future__ import annotations

import pytest
from pydantic import ValidationError

from polyzymd.analyses.base import MetricSpec, ScalarMeasurement, ScalarMeasurementAnalysis
from polyzymd.analyses.discovery import clear_cache, get_analysis
from polyzymd.analyses.{{ spec.name }} import (
    {{ spec.class_name }}Analysis,
    {{ spec.class_name }}Measurement,
    {{ spec.class_name }}Settings,
)


class FakeTrajectory:
    """Minimal trajectory with a configurable frame count."""

    def __init__(self, n_frames: int) -> None:
        self.n_frames = n_frames

    def __len__(self) -> int:
        """Return the fake frame count."""
        return self.n_frames


class FakeUniverse:
    """Minimal universe exposing a trajectory."""

    def __init__(self, n_frames: int = 10) -> None:
        self.trajectory = FakeTrajectory(n_frames)


class TestDiscovery:
    """Discovery and class-level contract behavior."""

    def test_discoverable_by_name(self):
        clear_cache()
        analysis_cls = get_analysis("{{ spec.name }}")

        assert analysis_cls is {{ spec.class_name }}Analysis
        assert analysis_cls.name == "{{ spec.name }}"

    def test_class_contract(self):
        assert issubclass({{ spec.class_name }}Analysis, ScalarMeasurementAnalysis)
        assert {{ spec.class_name }}Analysis.Settings is {{ spec.class_name }}Settings
        assert issubclass({{ spec.class_name }}Analysis.measurement, ScalarMeasurement)
        assert {{ spec.class_name }}Analysis.measurement is {{ spec.class_name }}Measurement


class TestSettings:
    """Settings validation behavior."""

    def test_default_scale(self):
        settings = {{ spec.class_name }}Settings()

        assert settings.scale == pytest.approx(1.0)

    def test_scale_must_be_positive(self):
        with pytest.raises(ValidationError):
            {{ spec.class_name }}Settings(scale=0.0)


class TestMeasurementLogic:
    """Measurement science logic independent of framework orchestration."""

    def test_measure_counts_windowed_frames_with_scale(self):
        measurement = {{ spec.class_name }}Measurement()
        settings = {{ spec.class_name }}Settings(scale=2.0)

        value = measurement.measure(FakeUniverse(10), settings, start=1, stop=8, step=2)

        assert value == pytest.approx(8.0)

    def test_measure_uses_full_trajectory_by_default(self):
        measurement = {{ spec.class_name }}Measurement()

        value = measurement.measure(FakeUniverse(5), {{ spec.class_name }}Settings())

        assert value == pytest.approx(5.0)

    def test_measure_rejects_non_positive_step(self):
        measurement = {{ spec.class_name }}Measurement()

        settings = {{ spec.class_name }}Settings()

        with pytest.raises(ValueError, match="positive"):
            measurement.measure(FakeUniverse(5), settings, step=0)


class TestMetricMetadata:
    """Metric metadata exposed by the scalar measurement."""

    def test_metric_spec(self):
        metric = {{ spec.class_name }}Measurement.metric

        assert isinstance(metric, MetricSpec)
        assert metric.name == "{{ spec.name }}_value"
        assert metric.higher_is_better is True
        assert metric.label == "{{ spec.title }} value"
        assert metric.unit == "frames"

    def test_metric_spec_converts_to_metric_value(self):
        metric_value = {{ spec.class_name }}Measurement.metric.to_metric_value(
            mean=2.0,
            sem=0.5,
            replicate_values=[1.0, 3.0],
        )

        assert metric_value.name == "{{ spec.name }}_value"
        assert metric_value.mean == pytest.approx(2.0)
        assert metric_value.sem == pytest.approx(0.5)
