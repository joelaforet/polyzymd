{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joelaforet/polyzymd/schemas/manifest-1.schema.json",
  "title": "PolyzyMD study manifest",
  "description": "manifest.json written by polyzymd study freeze: every file of a frozen study by size and SHA-256, the software versions, each condition's resolved config and replicates, and the warnings of the freeze. See docs/source/how_to/study_freeze.md.",
  "type": "object",
  "required": ["schema", "created", "versions", "equilibration", "stride", "conditions", "analyses", "files", "warnings"],
  "$defs": {
    "file": {
      "type": "object",
      "required": ["size", "sha256"],
      "properties": {
        "path": {"type": "string", "description": "Relative to the study folder, or to the folder holding the condition's runs."},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "replicate": {
      "type": "object",
      "required": ["files", "production_ns"],
      "properties": {
        "files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "engine_inputs": {"type": "array", "items": {"$ref": "#/$defs/file"}, "description": "Each path is relative to the deposit folder, and is the file's name in engine_inputs.zip."},
        "final_frame": {"$ref": "#/$defs/file", "description": "Its path is relative to the deposit folder, and is the file's name in final_frames.zip."},
        "production_frames": {"type": "integer"},
        "production_ns": {"type": "number", "description": "Time of the last production frame, in ns."},
        "trajectory_variant": {"type": ["string", "null"]},
        "missing_build_files": {"type": "array", "items": {"type": "string"}, "description": "Files build_manifest.json lists that are missing from the run directory."},
        "bond_source": {"type": ["string", "null"]},
        "simulated_with": {"type": "object", "description": "PolyzyMD, OpenMM and environment versions recorded by the build, and those versions with the OpenMM platform and its properties for each production segment."},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "properties": {
    "schema": {"const": "polyzymd-study-manifest/1"},
    "created": {"type": "string", "format": "date-time"},
    "tag": {"type": ["string", "null"]},
    "git": {"type": "object"},
    "study_file": {"$ref": "#/$defs/file"},
    "versions": {"type": "object", "required": ["polyzymd"], "additionalProperties": {"type": ["string", "null"]}},
    "equilibration": {"type": "string"},
    "stride": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object"},
    "conditions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["config", "replicates"],
        "properties": {
          "config": {"type": "string"},
          "config_hash": {"type": "string"},
          "engine": {"type": "string"},
          "resolved_config": {"type": "object"},
          "restraints": {"type": "array", "items": {"type": "object"}},
          "replicates": {"type": "object", "additionalProperties": {"$ref": "#/$defs/replicate"}}
        }
      }
    },
    "analyses": {"type": "object"},
    "trajectory_deposits": {"type": "array"},
    "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/file"}},
    "deposit_without_machine_paths": {"type": "array", "items": {"type": "string"}},
    "cite": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
