#!/bin/bash
# GROMACS Workflow Script
# {{ branding }}
# Generated on {{ generated_on }}
#
# Usage: ./{{ script_name }}
#
# This script runs the complete MD workflow:
#   1. Energy minimization
#   2. Equilibration (multiple stages if configured)
#   3. Production MD
#   4. Trajectory post-processing
#
# Each gmx mdrun gets the flags polyzymd run passes (gromacs: ntmpi, ntomp,
# gpu, mdrun_flags). Unlike polyzymd run, it does not continue a stopped
# stage from its checkpoint and records no progress; polyzymd run does both.

set -e  # Exit on error

# Configuration
GMX="{{ gmx_command }}"
PREFIX="{{ prefix }}"

echo "========================================"
echo "GROMACS Workflow for ${PREFIX}"
echo "========================================"
echo "{{ short_credit_line }}"
echo "Using GROMACS: $GMX"
echo ""

# A replicate run with the user's own protocol (its protocol/ or gromacs/protocol/
# holds files) is never run by PolyzyMD, so its trajectories stay as they are.
if find protocol ../protocol -type f -print -quit 2>/dev/null | grep -q .; then
    echo "STOP: $(pwd) was run with your own protocol (protocol/): PolyzyMD does not run it and submits no successor."
    exit 0
fi

# Run only files a passing physics audit vouched for, unchanged since: the
# build writes their hashes only when its audit passes. A run that started
# before PolyzyMD 1.3.0 has no hashes and continues from its own files.
if [ -f audited_files.sha256 ]; then
    if ! sha256sum --check --quiet audited_files.sha256; then
        echo "FATAL: files in $(pwd) changed since the build was audited (above). Restore them or build again."
        exit 1
    fi
elif [ -f em.gro ] || compgen -G "*.cpt" > /dev/null; then
    echo "NOTE: $(pwd) has no audited_files.sha256; this run started before PolyzyMD 1.3.0 and continues from its own files."
else
    echo "FATAL: $(pwd) has no audited_files.sha256: no passing physics audit vouches for these files. Build again with polyzymd build --format gromacs."
    exit 1
fi

{{ energy_minimization_block }}
{{ equilibration_block }}
{{ production_block }}
{{ postprocessing_block }}
{{ footer_block }}
