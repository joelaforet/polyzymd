  #       value: 100
  #       order: 10
  #     "100% EGMA":
  #       family: egma
  #       value: 100
  #       order: 20
  #     "1% EGPMA":
  #       family: egpma
  #       value: 1
  #       order: 30
  #     "2% EGPMA":
  #       family: egpma
  #       value: 2
  #       order: 40
  #     "5% EGPMA":
  #       family: egpma
  #       value: 5
  #       order: 50
  #     "10% EGPMA":
