# PolyzyMD Comparison Configuration
# Compare analyses across simulation conditions (e.g., polymer, temperature).
# Docs: https://polyzymd.readthedocs.io/en/latest/

name: {{ name | yaml_quote }}
description: "Comparison of simulation conditions"

# Control condition for relative comparisons.
# Must match one of the 'label' values in 'conditions' below, or null if none.
control: null

# ============================================================================
# Conditions
# ============================================================================
# Each condition points to a simulation's config.yaml file.
conditions:
  - label: "Condition A"
    config: "../path/to/condition_a/config.yaml"
    replicates: [1, 2, 3]

  - label: "Condition B"
    config: "../path/to/condition_b/config.yaml"
    replicates: [1, 2, 3]

# ============================================================================
# Defaults
# ============================================================================
defaults:
  equilibration_time: {{ eq_time | yaml_quote }}

# ============================================================================
# MDAnalysis Backend Policy (optional)
# ============================================================================
# Default behavior forwards no backend kwargs to MDAnalysis, so PolyzyMD-level
# replicate scheduling remains the only parallelism layer. Uncomment only when
# running a single local process and intentionally opting into MDAnalysis
# internal parallelism for AnalysisBase-compatible jobs.
#
# mda_backend_policy:
#   backend: "multiprocessing"  # e.g., multiprocessing or dask
#   n_workers: 2                # requires backend
#   n_parts: 2                  # optional; requires backend

# ============================================================================
# Plugins (unified analysis settings)
# ============================================================================
# Define which analyses to run. Presence of a section enables that analysis.

plugins:
  # RMSF, SASA and secondary structure are not configured here. Run them per
  # condition, for example
  #   polyzymd analyze rmsf -c A/config.yaml -c B/config.yaml
  #   polyzymd analyze sasa -c A/config.yaml -c B/config.yaml \
  #     --set contexts='{isolated: protein, with_polymer: protein or resname SBM EGM}'
  #   polyzymd analyze secondary_structure -c A/config.yaml -c B/config.yaml \
  #     --set selection='protein and chainID A'
  # Pick the total SASA with --run <context> and each residue's SASA with
  # --run <context>_residues. Pick the helix, strand or coil fraction with
  # --run <name>, or add --set scheme=full for the eight DSSP classes such as
  # alpha_helix, and each residue's fraction with --run <name>_residues.

  # Catalytic triad and pair distances are not configured here. Write the
  # pairs to pairs.yaml, a list of label, selection_a, selection_b and
  # optionally threshold, below_label and above_label, and run
  #   polyzymd analyze catalytic_triad -c A/config.yaml --set pairs=pairs.yaml
  #   polyzymd analyze distances -c A/config.yaml --set pairs=pairs.yaml
  # Always use "protein and resid X" for protein residues, because residue
  # numbers restart per chain.

  # Polymer-protein contacts are not configured here. Run
  #   polyzymd analyze contacts -c A/config.yaml -c B/config.yaml \
  #     --set polymer_selection='chainid C' --set protein_selection='chainid A'
  # Pick the result with --run, for example coverage, mean_contact_fraction,
  # contact_fraction_residues or mean_lifetime (how long contacts last). A
  # residue is in contact when the polymer occludes its SASA; add
  # --set method=distance to count a contact when a polymer atom is within
  # --set cutoff=<Å> (default 4.0) of the residue instead.

  # Hydrogen-bond Analysis
  #
  # hydrogen_bonds:
  #   distance_cutoff: 3.0
  #   angle_cutoff: 150
  #   groups:
  #     protein_all: "protein"
  #     substrate: "resname LIG"     # adjust to your ligand
  #     polymer_all: "chainid C"
  #   summaries:
  #     protein_polymer:
  #       between: [protein_all, polymer_all]
  #     protein_substrate:
  #       between: [protein_all, substrate]
  #     protein_internal:
  #       within: protein_all
  #     polymer_internal:
  #       within: polymer_all
  #   composition:
  #     partitions:
  #       protein: "protein"
  #       substrate: "resname LIG"
  #       polymer: "chainid C"

# ============================================================================
# Plot Settings (HOW to visualize - figure customization)
# ============================================================================
# Controls plot generation for all analyses. Per-analysis sections override
# defaults. Run `polyzymd compare plot-all` to generate all configured plots.

plot_settings:
  output_dir: "figures/"         # relative to this file
  format: "png"                  # png, pdf, or svg
  dpi: 300                       # resolution for raster formats
  style: "compact"               # compact, large_elements, or low_ink
  color_palette: "tab10"         # seaborn/matplotlib color palette

  # ── Semantic condition colors (optional) ───────────────────────────────────
  # Keep this block commented unless you want condition colors/order to encode
  # project-specific meaning. Semantic order is plot-only; it does not change
  # statistics, rankings, comparison JSON, or cached artifacts.
  #
  # semantic_colors:
  #   enabled: true
  #   order:
  #     - "No Polymer"
  #     - "100% SBMA"
  #     - "100% EGMA"
  #     - "1% EGPMA"
  #     - "2% EGPMA"
  #     - "5% EGPMA"
  #     - "10% EGPMA"
  #   control_color: "#222222"
  #   missing_color: "#bdbdbd"
