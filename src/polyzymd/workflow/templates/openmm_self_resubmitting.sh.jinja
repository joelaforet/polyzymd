#!/bin/bash
#SBATCH --partition={{ partition }}
#SBATCH --job-name={{ job_name }}
#SBATCH --output={{ output_file }}
{{ qos_line }}
{{ nodes_line }}
{{ cpus_line }}
{{ mem_line }}
#SBATCH --time={{ time_limit }}
{{ gpu_line }}
{{ mail_line }}
{{ account_line }}
{{ exclude_line }}
{{ nodelist_line }}
{{ constraint_line }}
#SBATCH --signal=B:USR1@300
#SBATCH --no-requeue

# =============================================================================
# PolyzyMD Self-Resubmitting Simulation Job
# {{ FULL_CREDIT_LINE }}
# Generated by polyzymd — do not edit manually
# =============================================================================

# Resolve this script before platform detection. A failed platform probe can
# submit the same request again before the current job exits.
THIS_SCRIPT="${SLURM_JOB_SCRIPT:-$(realpath "$0")}"
ROUTING_RETRY_COUNT="${POLYZYMD_ROUTING_RETRY_COUNT:-0}"
ROUTING_FAILED_NODES="${POLYZYMD_ROUTING_FAILED_NODES:-}"
ROUTING_RETRY_LIMIT=3
CONFIGURED_EXCLUDE={{ configured_exclude | shell_quote }}

# Union of comma-separated node lists, first-seen order, duplicates dropped.
merge_node_list() {
    printf '%s,' "$@" | tr ',' '\n' \
        | awk 'NF && !seen[$0]++ {printf "%s%s", sep, $0; sep=","} END {printf "\n"}'
}

# A chain stops when the run directory holds a STOP file (written by
# `polyzymd cancel`) or when POLYZYMD_STOP_CHAIN=1 is exported into the job.
# Checked before every successor submission so a cancelled chain stays
# cancelled instead of resurrecting itself within seconds of `scancel`.
stop_requested() {
    if [ "${POLYZYMD_STOP_CHAIN:-0}" = "1" ]; then
        echo "STOP: POLYZYMD_STOP_CHAIN=1 — not submitting a successor"
        return 0
    fi
    if [ -n "${STOP_FILE:-}" ] && [ -f "$STOP_FILE" ]; then
        echo "STOP: $STOP_FILE exists — not submitting a successor"
        echo "STOP: ---- $STOP_FILE ----"
        sed -n '1,20p' "$STOP_FILE" || true
        echo "STOP: -------------------------------"
        echo "STOP: remove the file (or run 'polyzymd cancel --resume') to restart the chain"
        return 0
    fi
    return 1
}

resubmit_after_routing_failure() {
    local reason="$1"
    echo "ROUTING: $reason" >&2

    if [[ ! "$ROUTING_RETRY_COUNT" =~ ^[0-9]+$ ]]; then
        echo "FATAL: invalid routing retry count: $ROUTING_RETRY_COUNT" >&2
        exit 1
    fi
    if [ -z "${SLURM_JOB_ID:-}" ] || [ -z "${SLURMD_NODENAME:-}" ]; then
        echo "FATAL: cannot resubmit outside an allocated SLURM node" >&2
        exit 1
    fi

    # Every node this chain has been routed away from, including this one.
    local failed_nodes
    failed_nodes="$(merge_node_list "$ROUTING_FAILED_NODES" "$SLURMD_NODENAME")"

    if (( ROUTING_RETRY_COUNT >= ROUTING_RETRY_LIMIT )); then
        echo "FATAL: CUDA routing failed after $ROUTING_RETRY_LIMIT retries;" \
             "incompatible nodes: $failed_nodes" >&2
        echo "FATAL: resubmit manually with --exclude=$failed_nodes once a" \
             "compatible node is available" >&2
        exit 1
    fi
    if stop_requested; then
        echo "ROUTING: stop requested — not rerouting; exiting cleanly" >&2
        exit 0
    fi

    local next_count=$((ROUTING_RETRY_COUNT + 1))
    local excluded_node
    excluded_node="$(merge_node_list "$CONFIGURED_EXCLUDE" "$failed_nodes")"
    echo "ROUTING: resubmitting to the same queue without $failed_nodes " \
         "(attempt $next_count/$ROUTING_RETRY_LIMIT)" >&2
    if sbatch \
        --dependency="afterany:$SLURM_JOB_ID" \
        --exclude="$excluded_node" \
        --export="ALL,POLYZYMD_ROUTING_RETRY_COUNT=$next_count,POLYZYMD_ROUTING_FAILED_NODES=$failed_nodes" \
        "$THIS_SCRIPT"; then
        echo "ROUTING: successor submitted; exiting current job" >&2
        exit 0
    fi

    echo "FATAL: CUDA routing failed and successor submission failed" >&2
    exit 1
}

# Select a compatible checked-in CUDA runtime before Pixi activation.
REQUESTED_PIXI_ENV={{ pixi_env | shell_quote }}
CONFIG_PATH={{ config_path | shell_quote }}
REPLICATE={{ replicate }}
WORKING_DIR={{ working_dir | shell_quote }}
STOP_FILE="${POLYZYMD_STOP_FILE:-$WORKING_DIR/STOP}"
RUNTIME_METADATA="$WORKING_DIR/runtime_platform.json"

# A successor that was already queued when the chain was cancelled must not
# start a new segment.  Bail out before the GPU probe so no production_N
# directory is created.
if stop_requested; then
    echo "STOP: not starting a segment for replicate $REPLICATE"
    exit 0
fi
PIXI_ENV="$REQUESTED_PIXI_ENV"
if [ -f "$RUNTIME_METADATA" ]; then
    RECORDED_PIXI_ENV="$(
        sed -n 's/.*"pixi_environment"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$RUNTIME_METADATA"
    )"
    if [[ ! "$RECORDED_PIXI_ENV" =~ ^sim-cuda-12-([046])$ ]]; then
        echo "FATAL: runtime metadata has no valid pixi_environment: $RUNTIME_METADATA" >&2
        exit 1
    fi
    if [ "$PIXI_ENV" = "auto" ]; then
        PIXI_ENV="$RECORDED_PIXI_ENV"
        echo "ROUTING: reusing recorded environment $PIXI_ENV"
    elif [ "$PIXI_ENV" != "$RECORDED_PIXI_ENV" ]; then
        echo "FATAL: requested environment $PIXI_ENV differs from recorded " \
             "$RECORDED_PIXI_ENV in $RUNTIME_METADATA" >&2
        exit 1
    fi
fi
GPU_QUERY="$(nvidia-smi --query-gpu=driver_version,compute_cap --format=csv,noheader 2>/dev/null | head -n 1)" || {
    resubmit_after_routing_failure "no queryable NVIDIA GPU is allocated; refusing CPU fallback"
}
if [[ ! "$GPU_QUERY" =~ ^([0-9]+)\.([0-9]+)[^,]*,[[:space:]]*([0-9]+)\.([0-9]+)$ ]]; then
    resubmit_after_routing_failure "malformed nvidia-smi output: $GPU_QUERY"
fi
DRIVER_MAJOR="${BASH_REMATCH[1]}"
DRIVER_MINOR="${BASH_REMATCH[2]}"
COMPUTE_CAP="${BASH_REMATCH[3]}.${BASH_REMATCH[4]}"
DRIVER_CODE=$((10#$DRIVER_MAJOR * 100 + 10#$DRIVER_MINOR))
if [ "$PIXI_ENV" = "auto" ]; then
    if (( DRIVER_CODE >= 56028 )); then
        PIXI_ENV="sim-cuda-12-6"
    elif (( DRIVER_CODE >= 55054 )); then
        PIXI_ENV="sim-cuda-12-4"
    elif (( DRIVER_CODE >= 52560 )); then
        PIXI_ENV="sim-cuda-12-0"
    else
        resubmit_after_routing_failure "unsupported NVIDIA driver $DRIVER_MAJOR.$DRIVER_MINOR"
    fi
elif [[ "$PIXI_ENV" =~ ^sim-cuda-12-([046])$ ]]; then
    case "$PIXI_ENV" in
        sim-cuda-12-6) REQUIRED_DRIVER=56028 ;;
        sim-cuda-12-4) REQUIRED_DRIVER=55054 ;;
        sim-cuda-12-0) REQUIRED_DRIVER=52560 ;;
    esac
    if (( DRIVER_CODE < REQUIRED_DRIVER )); then
        resubmit_after_routing_failure \
            "$PIXI_ENV is incompatible with driver $DRIVER_MAJOR.$DRIVER_MINOR"
    fi
else
    echo "FATAL: OpenMM GPU jobs require auto or a checked-in sim-cuda environment" >&2
    exit 1
fi

# The manifest path was resolved at submission time from `which polyzymd`.
eval "$(pixi shell-hook -e "$PIXI_ENV" --manifest-path {{ manifest_path | shell_quote }})"

# Enable strict error handling after environment setup
set -e

# Required for OpenFF Interchange.combine() functionality
export INTERCHANGE_EXPERIMENTAL=1

# Fail before molecular setup if CUDA kernel creation or execution is impossible.
if ! python - <<'PY'
import openmm
from openmm import unit

system = openmm.System()
system.addParticle(1.0)
system.addParticle(1.0)
force = openmm.NonbondedForce()
force.addParticle(1.0, 0.3, 0.1)
force.addParticle(-1.0, 0.3, 0.1)
system.addForce(force)
integrator = openmm.VerletIntegrator(1.0 * unit.femtosecond)
platform = openmm.Platform.getPlatformByName("CUDA")
context = openmm.Context(system, integrator, platform, {"Precision": "mixed"})
context.setPositions([[0.0, 0.0, 0.0], [0.4, 0.0, 0.0]] * unit.nanometer)
state = context.getState(getEnergy=True)
integrator.step(1)
selected = context.getPlatform().getName()
if selected != "CUDA":
    raise RuntimeError(f"CUDA preflight created an unexpected platform: {selected}")
print(
    "CUDA preflight:",
    f"OpenMM {openmm.__version__}",
    selected,
    f"precision={platform.getPropertyValue(context, 'Precision')}",
    f"device={platform.getPropertyValue(context, 'DeviceIndex')}",
    f"energy={state.getPotentialEnergy()}",
)
del context, integrator
PY
then
    resubmit_after_routing_failure "CUDA Context creation or execution failed"
fi

# Ensure working directory exists
mkdir -p "$WORKING_DIR"

echo "=================================================="
echo "PolyzyMD self-resubmitting job"
echo "{{ FULL_CREDIT_LINE }}"
echo "Config:    $CONFIG_PATH"
echo "Replicate: $REPLICATE"
echo "Work dir:  $WORKING_DIR"
echo "Pixi env:  $PIXI_ENV (requested: $REQUESTED_PIXI_ENV)"
echo "GPU:       compute $COMPUTE_CAP, driver $DRIVER_MAJOR.$DRIVER_MINOR"
echo "Job ID:    ${SLURM_JOB_ID:-local}"
echo "Timestamp: $(date)"
echo "=================================================="

RUNTIME_METADATA_TMP="$WORKING_DIR/.runtime_platform.json.$$"
export PIXI_ENV DRIVER_MAJOR DRIVER_MINOR COMPUTE_CAP
set +e
python - "$WORKING_DIR/runtime_platform.json" "$RUNTIME_METADATA_TMP" <<'PY'
import json
import os
import sys
from pathlib import Path
import openmm

published, temporary = map(Path, sys.argv[1:])
metadata = {
    "pixi_environment": os.environ["PIXI_ENV"],
    "openmm_version": openmm.__version__,
    "cuda_runtime": os.environ["PIXI_ENV"].removeprefix("sim-cuda-"),
    "platform": "CUDA",
    "precision": "mixed",
    "driver": f'{os.environ["DRIVER_MAJOR"]}.{os.environ["DRIVER_MINOR"]}',
    "device": os.environ.get("CUDA_VISIBLE_DEVICES", "unknown"),
    "compute_capability": os.environ["COMPUTE_CAP"],
}
if published.exists():
    previous = json.loads(published.read_text())
    immutable = ("pixi_environment", "openmm_version", "platform", "precision")
    changed = [key for key in immutable if previous.get(key) != metadata[key]]
    if changed:
        # Exit code 3 is the wrapper's "this node cannot honour the recorded
        # runtime" signal: the wrapper reroutes to another node instead of
        # killing the chain (a bare SystemExit under `set -e` left no
        # successor queued and silently ended the run).
        print(
            "runtime changed across replica resubmission: "
            + ", ".join(f"{key}={previous.get(key)!r}->{metadata[key]!r}" for key in changed),
            file=sys.stderr,
        )
        raise SystemExit(3)
temporary.write_text(json.dumps(metadata, sort_keys=True) + "\n")
PY
RUNTIME_METADATA_RC=$?
set -e
if [ "$RUNTIME_METADATA_RC" -eq 3 ]; then
    rm -f "$RUNTIME_METADATA_TMP"
    resubmit_after_routing_failure \
        "${SLURMD_NODENAME:-this node} cannot reproduce the recorded run runtime"
elif [ "$RUNTIME_METADATA_RC" -ne 0 ]; then
    rm -f "$RUNTIME_METADATA_TMP"
    echo "FATAL: could not record runtime metadata (exit $RUNTIME_METADATA_RC)" >&2
    exit "$RUNTIME_METADATA_RC"
fi
mv "$RUNTIME_METADATA_TMP" "$WORKING_DIR/runtime_platform.json"

# =========================================================================
# Signal forwarding: SLURM sends signals to the batch shell, not to child
# processes.  We trap SIGUSR1 (wall-time warning) and SIGTERM (preemption)
# and forward them to the Python process running in the background.
# =========================================================================
CHILD_PID=""
SUCCESSOR_RECEIPT="$WORKING_DIR/.successor-${SLURM_JOB_ID:-local}"
JOB_COMPLETE=0
STOP_HONOURED=0
resubmit_once() {
    if [ "$JOB_COMPLETE" -eq 1 ]; then
        return 0
    fi
    if stop_requested; then
        STOP_HONOURED=1
        return 0
    fi
    if [ -s "$SUCCESSOR_RECEIPT" ]; then
        echo "Successor already submitted: $(cat "$SUCCESSOR_RECEIPT")"
        return 0
    fi
    if [ -z "${SLURM_JOB_ID:-}" ]; then
        echo "FATAL: cannot submit a dependent successor without SLURM_JOB_ID"
        return 1
    fi
    # This node successfully reached `run-segment`, so the routing budget is
    # spent state from an unhealthy node and must not be inherited: reset the
    # counter and clear the accumulated exclusions for the successor.
    local result
    if ! result=$(sbatch \
        --dependency="afterany:$SLURM_JOB_ID" \
        --export="ALL,POLYZYMD_ROUTING_RETRY_COUNT=0,POLYZYMD_ROUTING_FAILED_NODES=" \
        "$THIS_SCRIPT"); then
        echo "FATAL: dependent successor submission failed"
        return 1
    fi
    printf '%s\n' "$result" > "$SUCCESSOR_RECEIPT.tmp"
    mv "$SUCCESSOR_RECEIPT.tmp" "$SUCCESSOR_RECEIPT"
    echo "Queued dependent successor: $result"
}
forward_signal() {
    local submit_rc=0
    resubmit_once || submit_rc=$?
    if [ -n "$CHILD_PID" ] && kill -0 "$CHILD_PID" 2>/dev/null; then
        echo "Forwarding $1 to Python process (PID $CHILD_PID)"
        kill -"$1" "$CHILD_PID"
    fi
    return "$submit_rc"
}
trap 'forward_signal USR1' USR1
trap 'forward_signal TERM' TERM

# Run the next segment (backgrounded for signal forwarding)
polyzymd{{ openff_logs_flag }} run-segment \
    -c "$CONFIG_PATH" \
    -r "$REPLICATE" \
    --scratch-dir "$WORKING_DIR"{{ skip_build_flag }} &
CHILD_PID=$!

# Wait for the child; 'wait' is interrupted by trapped signals, so loop
# until the child actually exits.  Temporarily disable 'set -e' so we can
# capture non-zero exit codes (e.g. 99 for graceful shutdown) without the
# shell exiting prematurely.
set +e
wait "$CHILD_PID" 2>/dev/null
RC=$?
while kill -0 "$CHILD_PID" 2>/dev/null; do
    wait "$CHILD_PID" 2>/dev/null
    RC=$?
done
set -e

echo "run-segment exited with code $RC at $(date)"

# =========================================================================
# Resubmission logic
# =========================================================================
if [ $RC -eq 2 ]; then
    echo "CONCURRENT: Another job is already running this replicate — NOT resubmitting."
    echo "This duplicate job chain will now terminate cleanly."
    exit 0
fi

if [ $RC -ne 0 ] && [ $RC -ne 99 ]; then
    echo "FATAL: run-segment failed (exit code $RC) — NOT resubmitting"
    exit $RC
fi

# Check whether more work remains
set +e
polyzymd check-progress -c "$CONFIG_PATH" -r "$REPLICATE" --scratch-dir "$WORKING_DIR"
PROGRESS_RC=$?
set -e

if [ $PROGRESS_RC -eq 0 ]; then
    JOB_COMPLETE=1
    rm -f "$SUCCESSOR_RECEIPT"
    echo "Simulation complete — no resubmission needed."
    exit 0
fi

if [ $PROGRESS_RC -ne 1 ]; then
    echo "FATAL: check-progress failed (exit code $PROGRESS_RC) — NOT resubmitting"
    exit $PROGRESS_RC
fi

# Work remains (exit code 1) — reuse a signal-created successor or submit now
echo "Work remains — resubmitting job..."
if resubmit_once; then
    if [ "$STOP_HONOURED" -eq 1 ]; then
        echo "Chain stopped by request — no successor queued."
        exit 0
    fi
    echo "Successor is queued."
else
    echo "WARNING: sbatch resubmission failed"
    echo "You can manually resume with:"
    echo "  sbatch $THIS_SCRIPT"
    exit 1
fi

exit 0
