{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-gate.sh",
            "statusMessage": "Checking ruff, black and the scientific tests before the commit",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
